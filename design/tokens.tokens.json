{
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "ink": { "$type": "color", "$value": "#141416", "$extensions": { "figma.codeSyntax": "var(--ink)" } },
    "oyster": { "$type": "color", "$value": "#F3F0E8", "$extensions": { "figma.codeSyntax": "var(--oyster)" } },
    "cobalt": { "$type": "color", "$value": "#384BFF", "$extensions": { "figma.codeSyntax": "var(--cobalt)" } },
    "persimmon": { "$type": "color", "$value": "#FF6548", "$extensions": { "figma.codeSyntax": "var(--persimmon)" } },
    "mist": { "$type": "color", "$value": "#DDE3FF", "$extensions": { "figma.codeSyntax": "var(--mist)" } },
    "coffee": { "$type": "color", "$value": "#704332", "$extensions": { "figma.codeSyntax": "var(--coffee)" } }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": "999px" },
    "field": { "$type": "dimension", "$value": "16px" },
    "card": { "$type": "dimension", "$value": "28px" },
    "panel": { "$type": "dimension", "$value": "30px" }
  },
  "type": {
    "family": {
      "display": { "$type": "fontFamily", "$value": "Unbounded Variable" },
      "ui": { "$type": "fontFamily", "$value": "Manrope Variable" }
    },
    "size": {
      "label": { "$type": "dimension", "$value": "12px" },
      "body-small": { "$type": "dimension", "$value": "14px" },
      "body": { "$type": "dimension", "$value": "16px" },
      "title": { "$type": "dimension", "$value": "32px" },
      "display": { "$type": "dimension", "$value": "96px" }
    }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "160ms" },
    "page": { "$type": "duration", "$value": "420ms" },
    "ease-out": { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1] }
  }
}
